#!/usr/bin/env bash
# Centinela de cron para scripts/agentes/vigilar-tarjetas.py (repo arky-sup).
# Corre --cron contra la huella mas reciente de cada tablero del plan maestro
# que se decida vigilar aqui -- lista a mano, igual que PLANES en comun.sh.
# Silencio total en stdout = nada que avisar (patron --no-agent de Hermes
# cron: "Empty stdout = silent"). Si algo falla, el script real escribe su
# propio latido con el error y termina con codigo distinto de cero, lo que
# dispara --failure-deliver de este job.
set -u
REPO=/home/tata/workspace/arky-sup
HUELLAS=(
  "latam-factory:${REPO}/scripts/agentes/task-fingerprints/latam-factory-*.json"
  "latam-factory-e2e:${REPO}/scripts/agentes/task-fingerprints/latam-factory-e2e-*.json"
)
EXIT=0
for entry in "${HUELLAS[@]}"; do
  tablero="${entry%%:*}"
  patron="${entry#*:}"
  # shellcheck disable=SC2086
  ultima=$(ls -t $patron 2>/dev/null | head -1)
  if [ -z "$ultima" ]; then
    echo "VIGILANCIA: no hay huella capturada todavia para $tablero (scripts/agentes/capturar-huella.py)"
    EXIT=1
    continue
  fi
  python3 "${REPO}/scripts/agentes/vigilar-tarjetas.py" "$ultima" --cron
  rc=$?
  [ "$rc" != 0 ] && EXIT=$rc
done
exit "$EXIT"
