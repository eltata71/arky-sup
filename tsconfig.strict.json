{
  // The base configuration now enforces full strictness repository-wide.
  // This project remains as an additive high-risk gate: its enrolled modules
  // must also have no unused declarations, explicit overrides and complete
  // returns. It no longer represents the boundary of strict coverage.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": false
  },
  "include": [
    "lib/authz/**/*.ts",
    "lib/errorMessage.ts",
    "lib/ids.ts",
    "lib/richText/**/*.ts",
    "lib/security.ts",
    "lib/speechRecognition.ts",
    "lib/traceId.ts",
    "services/ai/aiProxyPolicy.ts",

    // Ambient declarations the listed modules rely on. Without them
    // `import.meta.env` is unknown here and every flag read looks like an
    // error, and `dagre` — which ships none — reads as an implicit `any`.
    "env.d.ts",
    "types/dagre.d.ts",

    // Wave 4. The modules that decide business rules, minus their Firestore
    // repositories: `tsc` checks everything reachable, and a repository still
    // delegates to `services/firestoreService.ts`, which has 57 errors under
    // `strict`. Enrolling one would mean fixing that monolith first, which is
    // exactly what the vertical-by-vertical migration is dismantling. The
    // model and the rules — where the risk actually lives — are in.
    //
    // `services/chat/chatCompactor.ts` is out for the same reason at one
    // remove: it imports the `services/ai` barrel, and a barrel is the whole
    // module. Enrol it when the AI layer stops reaching the monolith.
    "lib/diagram/**/*.ts",
    "services/observability/**/*.ts",
    "services/memory/**/*.ts",
    "services/chat/ChatTypes.ts",
    "services/chat/chatHistory.ts",
    "services/architectureProjects/ArchitectureProjectTypes.ts",
    "services/architectureProjects/architectureProjectFactory.ts",
    "services/architectureProjects/attentionTracking.ts",
    "services/artifacts/application/artifactWorkflow.ts",
    "services/ai/generation/legacyTransport.ts",
    "services/ai/generation/artifactSuggestions.ts",
    "lib/artifacts/generationPhase.ts",
    "services/ai/generation/recommendation/index.ts",
    "services/ai/generation/recommendationService.ts",
    "services/ai/generation/documentGenerationService.ts",
    "services/ai/generation/diagramGenerationService.ts",
    "services/ai/generation/assistant/index.ts",
    // F5-01 corte 14: el puerto que deja al motor vivir en `services/ai`, y los
    // ayudantes de prompt que salieron con él. El motor no entra: aún arrastra
    // el SDK de Gemini y la mitad del grafo de dominio.
    "services/ai/generation/artifacts/artifactGenerationSupport.ts",
    "services/ai/generation/artifacts/artifactPromptReinforcements.ts",
    // F5-02: la regla del `modifyArtifact`, el día que se escribe. Las otras
    // tres que salieron de pantallas no pueden entrar todavía: `portfolioGraph`
    // lee los tipos de la Oficina, y la Oficina alcanza el motor.
    "services/agent/artifactModificationCall.ts",
    // F5-03: el resumen de conversación y su mitad sin modelo.
    "lib/conversationDigest.ts",
    "services/chat/compactionDigest.ts",
    "services/ai/generation/chatCompaction.ts",
    "services/businessInitiatives/domain/**/*.ts",
    "services/review/ReviewTypes.ts",
    "services/review/reviewTransitions.ts",
    "services/review/localArtifactReviewRepository.ts",

    // Captura asistida. El catálogo de campos y su contrato entran el día que
    // se escriben, que es lo que `CLAUDE.md` pide del código nuevo: no
    // dependen de nada — son declaraciones de la capa fundacional.
    //
    // `officeAgentProfile.ts` y `officeConsolidationReview.ts` son igual de
    // puros y se quedaron fuera por la razón ya escrita arriba, a un paso de
    // distancia: los dos leen `officeAgentPersonas`, que importa el barril de
    // `services/agent` para declarar su puerto de persona, y un barril es el
    // módulo entero. Entran cuando la capa de IA deje de alcanzar al motor.
    "lib/capture/**/*.ts",

    // La guía de uso de la plataforma, por lo mismo: el contrato, la búsqueda
    // léxica y el catálogo de temas son declaraciones puras de la capa
    // fundacional, y entran el día que se escriben.
    "lib/platformGuide/**/*.ts",

    // Ola 2. Los repositorios entran.
    //
    // No estaban por una sola razón, escrita arriba: `tsc` comprueba el cierre
    // transitivo y todos delegaban en `services/firestoreService.ts`, que tenía
    // 57 errores bajo `strict`. Un fichero mantenía fuera a los siete contextos
    // que guardan datos. Ese fichero ya no existe: cada contexto tiene su
    // adaptador sobre `services/persistence`, y con él el camino a `strict`.
    //
    // Los que faltan y por qué, para que nadie lo redescubra: los repositorios
    // de chat y del agente llegan, vía `chatCompactor` y `agentTypes`, al
    // barril de `services/ai` — y un barril es el módulo entero, `geminiService`
    // incluido. Entran cuando la capa de IA deje de alcanzar al motor, en la
    // Ola 5; es el mismo motivo por el que `chatCompactor` lleva fuera desde
    // la Ola 4.
    "services/persistence/**/*.ts",
    // F3.1-F3.2. Puertos y adaptadores: nacen en strict (sin SDK, funciones puras).
    "services/ports/**/*.ts",
    "services/adapters/**/*.ts",
    "services/architectureProjects/projectCache.ts",
    "services/architectureProjects/projectDocumentMapper.ts",
    "services/architectureProjects/artifactDocumentMapper.ts",
    "services/settings/**/*.ts"
  ]
}
