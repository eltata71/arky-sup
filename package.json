{
  "name": "arkypro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-arky \"npx vitest run __tests__/rules\"",
    "test:coverage": "vitest run --coverage",
    "test:shard": "vitest run --coverage --reporter=blob",
    "test:merge-reports": "vitest --merge-reports --coverage",
    "e2e": "playwright test",
    "e2e:seed": "node scripts/seedE2E.mjs",
    "e2e:install": "playwright install chromium webkit",
    "check:bundle-secrets": "node scripts/checkBundleSecrets.mjs dist",
    "check:any-budget": "node scripts/countAnyTokens.mjs",
    "check:no-orphan-scripts": "node scripts/checkOrphanScripts.mjs",
    "check:bundle-budget": "node scripts/checkBundleBudget.mjs dist",
    "storage:inventory": "node scripts/storage/storageInventory.mjs",
    "check:module-size": "node scripts/checkModuleSize.mjs",
    "check:module-boundaries": "node scripts/checkModuleBoundaries.mjs",
    "quality:static": "npm run typecheck && npm run typecheck:strict && npm run lint && npm run check:any-budget && npm run check:no-orphan-scripts && npm run check:module-size && npm run check:module-boundaries",
    "quality:fast": "npm run quality:static && npm run test:ci",
    "build:placeholders": "node scripts/buildWithPlaceholders.mjs",
    "quality": "npm run quality:static && npm run test:coverage && npm run build:placeholders && npm run check:bundle-secrets && npm run check:bundle-budget",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.17.6",
    "@google/genai": "^1.27.0",
    "@supabase/supabase-js": "^2.116.0",
    "dagre": "0.8.5",
    "dompurify": "^3.4.15",
    "elkjs": "^0.12.0",
    "firebase": "^12.9.0",
    "html-to-image": "1.11.13",
    "lucide-react": "^0.575.0",
    "marked": "^12.0.1",
    "mermaid": "^10.9.0",
    "motion": "^12.34.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "3.6.0",
    "reactflow": "11.11.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
