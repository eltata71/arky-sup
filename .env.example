# =============================================================================
# Arky 10 — Variables de Entorno
# =============================================================================
# Copia este archivo como .env.local y completa los valores.
# NUNCA commitear .env.local (ya está en .gitignore).
#
# En Vercel: configura estas mismas variables en
#   Settings > Environment Variables
# =============================================================================

# --- Google Gemini AI ---
# API Key para funciones de inteligencia artificial.
# Los usuarios también pueden ingresar su propia llave desde Configuración > IA.
VITE_GEMINI_API_KEY=

# Opcional (legacy, sólo Gemini): URL del proxy serverless de Vercel para
# ocultar la API key, normalizar errores y aplicar rate limit por sesión/IP.
# Ej.: /api/gemini
VITE_GEMINI_PROXY_URL=

# --- OpenRouter (opcional) ---
# API Key para usar OpenRouter como proveedor alternativo de IA.
# Los usuarios también pueden pegar su propia llave desde Configuración > IA
# (se guarda en localStorage, campo 'user_openrouter_key').
VITE_OPENROUTER_API_KEY=

# =============================================================================
# Proxy de IA agnóstico de proveedor (recomendado en producción)
# =============================================================================
# Con la app frontend-only, cualquier VITE_*_API_KEY global viaja en el bundle
# del navegador. Apuntando VITE_AI_PROXY_URL a la función serverless `api/ai.ts`
# la llave se queda en el servidor: el cliente sólo envía el prompt.
#
# Opcional. Vacío significa dos cosas distintas según el build:
#   - `npm run dev`: no hay proxy (no hay función serverless que servir) y la
#     llamada va directa al proveedor, igual que hoy.
#   - build de producción: se usa `/api/ai`, la función que este mismo repo
#     despliega al lado del bundle. Sólo hay que rellenar esta variable si el
#     proxy vive en otro sitio (otro dominio, otra ruta).
# Ojo: en producción el proxy es obligatorio (fail-closed), así que el servidor
# necesita además GEMINI_API_KEY / OPENROUTER_API_KEY — ver más abajo.
VITE_AI_PROXY_URL=

# Hace OBLIGATORIO el proxy (fail-closed). Con `true`, una caída o mala
# configuración del proxy produce un error tipado, recuperable y observable en
# lugar de una llamada directa al proveedor con la llave del operador.
#
# Apagado por defecto a propósito: encenderlo sin un proxy verificado deja la
# aplicación sin IA. Actívelo sólo cuando `VITE_AI_PROXY_URL` esté probado en
# el despliegue.
#
# La única llamada directa que sigue permitida es BYOK: el usuario eligió
# «mi propia clave» en Ajustes > IA *y* guardó una. Esa llamada gasta una
# credencial suya, no la del operador.
VITE_AI_STRICT_PROXY=

# Clave de Anthropic (Claude). Igual que las demás: el usuario puede aportar la
# suya desde Configuración > IA (se guarda en localStorage como
# `user_anthropic_key`).
VITE_ANTHROPIC_API_KEY=

# --- Variables SÓLO de servidor (sin prefijo VITE_ → nunca entran al bundle) ---
# Configúralas en Vercel > Settings > Environment Variables. Son las llaves que
# usa `api/ai.ts` para hablar con cada proveedor.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# Rate limit local del proxy, peticiones por ventana de 60s (default: 60).
# AI_PROXY_MAX_REQUESTS_PER_WINDOW=60
# Equivalente para el proxy legacy `api/gemini.ts` (default: 60).
# GEMINI_PROXY_MAX_REQUESTS_PER_WINDOW=60
#
# OBLIGATORIA para que el proxy funcione. El proxy verifica el ID token de
# Firebase que envía el cliente y sólo entonces gasta la clave del proveedor;
# sin este valor rechaza toda petición con 401. No es un secreto — es el mismo
# id que ya viaja en el bundle como VITE_FIREBASE_PROJECT_ID — pero el servidor
# necesita conocerlo para validar la audiencia del token.
# FIREBASE_PROJECT_ID=
#
# Escotilla de transición: acepta llamadas sin verificar. Pensada sólo para que
# un despliegue existente pueda actualizar mientras se provisiona
# FIREBASE_PROJECT_ID. Cada petición que la use queda registrada.
# AI_PROXY_ALLOW_UNAUTHENTICATED=false
#
# Lista blanca de modelos que el proxy acepta, separados por comas. Vacía =
# cualquiera. Con varios proveedores detrás de un mismo endpoint, un modelo
# elegido libremente por el cliente es una factura elegida libremente por el
# cliente.
# AI_PROXY_ALLOWED_MODELS=

# Permite deshabilitar el gate de runtime config para un despliegue cuyo
# aprovisionamiento de variables vive fuera de este repositorio (hoy: el
# dashboard de Vercel). ESCOTILLA, no ajuste: el despliegue que la activa pierde
# todos los chequeos, incluido el que evita claves de operador en el bundle.
# VITE_DISABLE_RUNTIME_CONFIG_GATE=false

# --- Firebase ---
# Configuración del proyecto Firebase (credenciales públicas del cliente).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Lucidchart ---
# API token (Bearer) para la integración real con Lucidchart.
# Pasos: Lucid.app > Account > API > crea un token de usuario.
# Si se deja vacío, la app degradará a la vista local + "Copiar Mermaid".
# Los usuarios también pueden pegar un token personal desde el botón de llave
# en el visor de Lucidchart; se guarda sólo en localStorage del navegador.
VITE_LUCID_API_KEY=

# --- Pipeline de diagramas ---
# "canonical" (por defecto): parser + renderer deterministas en TypeScript.
# "ai": fallback al pipeline anterior basado en Gemini (para regresiones).
VITE_DIAGRAM_PIPELINE=canonical


# --- Refinamiento semántico de artefactos ---
# Determinístico por defecto: evalúa y repara documentos/diagramas antes de persistir.
# Setear false sólo como kill switch ante regresiones operativas.
VITE_ARTIFACT_REFINEMENT_ENABLED=true
# IA deshabilitada por defecto: cuando true, el refinamiento puede pedir crítica/refinado
# a Gemini usando el fallback centralizado del servicio existente.
VITE_ARTIFACT_REFINEMENT_AI_ENABLED=false
# Límite defensivo de pasadas de refinamiento antes de persistir (default: 2).
VITE_ARTIFACT_REFINEMENT_MAX_PASSES=2

# --- Artefacto a solicitud: brief estructurado y selección de contexto ---
# Kill switch para volver al flujo legacy de texto libre + recomendación única.
VITE_STRUCTURED_ARTIFACT_BRIEF_ENABLED=true
# IA deshabilitada por defecto: el brief se extrae por heurísticas determinísticas.
VITE_AI_BRIEF_EXTRACTION_ENABLED=false
# Cuando true, muestra Top 3 de candidatos; cuando false conserva recomendación principal.
VITE_TOP3_ARTIFACT_RECOMMENDATIONS_ENABLED=true

# --- Seguridad / endurecimiento ---
# Habilita el botón "Entrar como Administrador (Modo Desarrollo)" en AuthPage.
# SOLO funciona en builds de desarrollo (vite dev). En producción siempre
# se ignora aunque esté seteado. Ver docs/security-hardening.md.
# VITE_ENABLE_DEV_LOGIN=true

# Permite el bootstrap "primer usuario registrado = superadmin" en producción.
# Sin esta flag, todos los nuevos registros quedan como `student` y un
# superadmin debe ser sembrado server-side (Custom Claims). Ver
# docs/security-hardening.md.
