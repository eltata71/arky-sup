# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
coverage/
# Blob reports written by `vitest --reporter=blob`, the input to
# `vitest --merge-reports`. Written per shard in CI, never committed.
.vitest-reports/
dist-ssr
*.local

# Bytecode de las herramientas de migración Python.
__pycache__/
*.py[cod]

# Exportaciones de origen, mapas de identidad y cargas ETL contienen PII.
# Se mantienen locales, con permisos de propietario, y nunca se versionan.
.migration-private/

# Playwright / E2E — artifactos de ejecución local (nunca versionar)
test-results/
playwright-report/
blob-report/
.playwright/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Espacio de trabajo Hermes — reportes/notas privadas (no versionar)
.hermes/workspace/reports/
.hermes/workspace/docs/
*.session-note.md

# Firebase emulator logs
firestore-debug.log
firebase-debug.log
ui-debug.log
.vercel
.env.local
