# npm 10 strict peer-dep resolver vs the React 18 + ESLint 9 + Firebase
# transitive graph occasionally produces ERESOLVE conflicts that are not
# real incompatibilities (e.g. peerOptional ranges that arrive late).
#
# Falling back to the legacy resolver mirrors what `npm install
# --legacy-peer-deps` does on developer machines, and — crucially — is
# what Vercel's build step runs by default. Setting it here makes the
# behaviour consistent across local, CI and Vercel without anyone having
# to remember the flag.
#
# Whenever a true incompatibility surfaces, prefer pinning the offending
# package over relying on this — see docs/security-hardening.md for the
# update playbook.
legacy-peer-deps=true
